// SIMULACIONES INTERACTIVAS P5.JS PARA CADA TARJETA

// 1. Certified Lover Boy (Ritmo orgánico y formas rosadas)
new p5(function(p) {
  p.setup = function() {
    let c = p.createCanvas(p.select('#p5-canvas-1').width, 220);
    c.parent('p5-canvas-1');
  };
  p.draw = function() {
    p.background(20, 25, 18);
    p.noStroke();
    let t = p.frameCount * 0.03;
    for (let i = 0; i < 5; i++) {
      let r = 30 + p.sin(t + i) * 15;
      p.fill(255, 51, 153, 180 - i * 30);
      let x = p.width / 2 + p.cos(t + i) * (30 + i * 15);
      let y = p.height / 2 + p.sin(t + i) * (20 + i * 10);
      p.ellipse(x, y, r * 2);
    }
  };
}, 'p5-canvas-1');

// 2. Sin Boleto (Red vectorial y movimiento)
new p5(function(p) {
  p.setup = function() {
    let c = p.createCanvas(p.select('#p5-canvas-2').width, 220);
    c.parent('p5-canvas-2');
  };
  p.draw = function() {
    p.background(15, 18, 14);
    p.stroke(255, 153, 204, 150);
    p.strokeWeight(1.5);
    p.noFill();
    for (let x = 10; x < p.width; x += 25) {
      for (let y = 10; y < p.height; y += 25) {
        let d = p.dist(x, y, p.mouseX, p.mouseY);
        let size = p.map(d, 0, 200, 15, 2, true);
        p.ellipse(x, y, size, size);
      }
    }
  };
}, 'p5-canvas-2');

// 3. Juego de Feria (Geometría lúdica interactiva)
new p5(function(p) {
  p.setup = function() {
    let c = p.createCanvas(p.select('#p5-canvas-3').width, 220);
    c.parent('p5-canvas-3');
  };
  p.draw = function() {
    p.background(25, 32, 22);
    p.rectMode(p.CENTER);
    p.stroke(255, 51, 153);
    p.strokeWeight(2);
    p.fill(63, 84, 49, 200);
    let rot = p.frameCount * 0.02;
    p.push();
    p.translate(p.width / 2, p.height / 2);
    p.rotate(rot);
    p.rect(0, 0, 80, 80);
    p.rotate(-rot * 2);
    p.fill(255, 153, 204, 180);
    p.rect(0, 0, 45, 45);
    p.pop();
  };
}, 'p5-canvas-3');

// 4. Cascada Telar (Líneas verticales y trama textil)
new p5(function(p) {
  p.setup = function() {
    let c = p.createCanvas(p.select('#p5-canvas-4').width, 220);
    c.parent('p5-canvas-4');
  };
  p.draw = function() {
    p.background(18, 22, 16);
    p.strokeWeight(2);
    for (let i = 0; i < p.width; i += 12) {
      let offset = p.sin(p.frameCount * 0.05 + i * 0.1) * 20;
      if (i % 24 === 0) {
        p.stroke(255, 51, 153);
      } else {
        p.stroke(63, 84, 49);
      }
      p.line(i, 0, i + offset, p.height);
    }
  };
}, 'p5-canvas-4');

// 5. Fluctuación Lumínica (Tramas de halftones verdes y negros)
new p5(function(p) {
  p.setup = function() {
    let c = p.createCanvas(p.select('#p5-canvas-5').width, 220);
    c.parent('p5-canvas-5');
  };
  p.draw = function() {
    p.background(13, 15, 12);
    p.noStroke();
    let mx = p.constrain(p.mouseX, 0, p.width);
    for (let x = 15; x < p.width; x += 18) {
      for (let y = 15; y < p.height; y += 18) {
        let d = p.dist(x, y, mx, p.height / 2);
        let rad = p.map(d, 0, 180, 14, 3, true);
        p.fill(120, 200, 80, 220);
        p.ellipse(x, y, rad);
        p.fill(0, 150);
        p.ellipse(x + 2, y + 2, rad * 0.5);
      }
    }
  };
}, 'p5-canvas-5');
